{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Spoo.me Docs",
  "colors": {
    "primary": "#A855F7",
    "light": "#C084FC",
    "dark": "#7C3AED"
  },
  "favicon": "/images/logo/logo.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "api-keys",
              "rate-limits"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "custom-domains"
            ]
          },
          {
            "group": "Tools & Libraries",
            "pages": [
              "tools/python-library",
              "tools/github-action",
              "tools/spoobot"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API v1",
            "openapi": "openapi-v1.json",
            "pages": [
              {
                "group": "URL Shortening",
                "icon": "link",
                "pages": [
                  "POST /api/v1/shorten",
                  "GET /api/v1/shorten/check-alias"
                ]
              },
              {
                "group": "Link Management",
                "icon": "list-check",
                "pages": [
                  "GET /api/v1/urls",
                  "PATCH /api/v1/urls/{url_id}",
                  "PATCH /api/v1/urls/{url_id}/status",
                  "DELETE /api/v1/urls/{url_id}",
                  "DELETE /api/v1/urls"
                ]
              },
              {
                "group": "Statistics",
                "icon": "chart-line",
                "pages": [
                  "GET /api/v1/stats",
                  "GET /api/v1/export"
                ]
              },
              {
                "group": "Custom Domains",
                "icon": "globe",
                "pages": [
                  "POST /api/v1/custom-domains",
                  "GET /api/v1/custom-domains",
                  "GET /api/v1/custom-domains/{domain_id}",
                  "POST /api/v1/custom-domains/{domain_id}/verify",
                  "PATCH /api/v1/custom-domains/{domain_id}",
                  "DELETE /api/v1/custom-domains/{domain_id}",
                  "DELETE /api/v1/custom-domains/{domain_id}/permanent"
                ]
              }
            ]
          },
          {
            "group": "API v0 (Legacy)",
            "openapi": "openapi-v0.json",
            "pages": [
              {
                "group": "URL Shortening",
                "icon": "unlink",
                "pages": [
                  "api-reference/shorten-url",
                  "POST /emoji"
                ]
              },
              {
                "group": "Analytics",
                "icon": "chart-spline",
                "pages": [
                  "POST /stats/{shortCode}"
                ]
              },
              {
                "group": "Data Export",
                "icon": "file-down",
                "pages": [
                  "POST /export/{shortCode}/{exportFormat}"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Self-Hosting",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "self-hosting/introduction",
              "self-hosting/configuration"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "self-hosting/docker-deployment",
              "self-hosting/deploy-vercel",
              "self-hosting/deploy-railway",
              "self-hosting/deploy-render",
              "self-hosting/deploy-koyeb",
              "self-hosting/local-development"
            ]
          },
          {
            "group": "Setting Up",
            "pages": [
              "self-hosting/setting-up-mongo",
              "self-hosting/setting-up-redis",
              "self-hosting/setting-up-authentication",
              "self-hosting/creating-discord-webhooks"
            ]
          }
        ]
      },
      {
        "tab": "spoo-qr",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "qr/introduction"
            ]
          },
          {
            "group": "API Reference",
            "openapi": "openapi-qr.json",
            "pages": [
              {
                "group": "Classic",
                "icon": "scan",
                "pages": [
                  "GET /api/v1/classic",
                  "POST /api/v1/classic"
                ]
              },
              {
                "group": "Gradient",
                "icon": "palette",
                "pages": [
                  "GET /api/v1/gradient",
                  "POST /api/v1/gradient"
                ]
              },
              {
                "group": "Batch",
                "icon": "layers",
                "pages": [
                  "POST /api/v1/batch"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/self-hosting/cloud-deployment",
      "destination": "/self-hosting/deploy-vercel"
    }
  ],
  "logo": {
    "light": "/images/logo/logo-full-light.png",
    "dark": "/images/logo/logo-full-dark.png",
    "href": "https://spoo.me"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://spoo.me/discord"
      },
      {
        "label": "Support",
        "href": "https://spoo.me/contact"
      }
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://spoo.me/discord",
      "github": "https://spoo.me/github",
      "twitter": "https://x.com/spoo_me",
      "instagram": "https://www.instagram.com/spoo.me",
      "linkedin": "https://www.linkedin.com/company/spoo-me",
      "youtube": "https://www.youtube.com/@spoo-me"
    }
  },
  "topbar": {
    "style": "gradient"
  }
}
